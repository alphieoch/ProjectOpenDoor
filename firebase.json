{
  "hosting": {
    "site": "opendoor-f39a4",
    "public": "infra/gcp/hosting-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/v1/**",
        "run": {
          "serviceId": "opendoor-gateway",
          "region": "us-central1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "opendoor-gateway",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "run": {
          "serviceId": "opendoor-dashboard",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "/v1/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}
