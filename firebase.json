{
  "hosting": {
    "site": "opendoor-gcp",
    "public": "infra/gcp/hosting-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/v1/**",
        "run": {
          "serviceId": "opendoor-gateway",
          "region": "us-central1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "opendoor-gateway",
          "region": "us-central1"
        }
      },
      {
        "source": "/gateway/status",
        "run": {
          "serviceId": "opendoor-gateway",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "run": {
          "serviceId": "opendoor-dashboard",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "/v1/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Headers",
            "value": "Authorization, Content-Type, X-OpenDoor-Organization-Id, X-Data-Class"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
