# OpenDoor Environment Variables

# Database
DATABASE_URL=postgresql://localhost:5432/opendoor

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=your-super-secret-jwt-key-change-in-production

# Gateway
GATEWAY_API_KEY_HASH_SECRET=another-secret-for-hashing-api-keys
PORT=3001

# Dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3010
# Public status / API — same origin in prod (Firebase Hosting rewrites /v1 to gateway)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
# Optional extra browser origins for the gateway (comma-separated). Never `*` with cookies.
# GATEWAY_CORS_ORIGINS=https://app.example.com
# Product docs are served by the dashboard at /docs (same origin).
# NEXT_PUBLIC_DOCS_URL is unused; keep docs markdown in /docs + docs.json.
# Production: https://opendoor-gcp.web.app for both APP and GATEWAY URLs
PORT=3000

# PostHog (ProjectOpenDoor — https://us.posthog.com/project/407244)
# Project API key from PostHog Project Settings (safe in the browser; still treat as a secret in CI logs).
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# Ingestion API host: US default below; use https://eu.i.posthog.com for EU.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Toolbar / session replay “open in PostHog” UI (match your PostHog region).
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Used to build person / session replay links on support tickets.
NEXT_PUBLIC_POSTHOG_PROJECT_ID=407244
# Same key for Next.js server and the Bun gateway (server-only env is fine too).
POSTHOG_API_KEY=phc_your_project_api_key
POSTHOG_HOST=https://us.i.posthog.com

# Linear (dashboard support inbox — https://linear.app)
# Personal or workspace API key with issue create/read on the Support team.
LINEAR_API_KEY=lin_api_...
# Team UUID from Linear Settings → Teams → Support (create that team if it does not exist).
LINEAR_SUPPORT_TEAM_ID=
# Optional Linear project UUID for support/user-report tickets (e.g. Self-heal).
# LINEAR_SUPPORT_PROJECT_ID=1259fce9-8751-45b4-a2c7-e39088feae3d
# Self-heal queue (PostHog → Linear → Jules). Team defaults to Ochieng&Co if unset.
# LINEAR_SELF_HEAL_TEAM_ID=
# JULES_REPO=alphieoch/ProjectOpenDoor
# JULES_SOURCE_BRANCH=main
# JULES_API_KEY=   # Jules Settings → API key (GitHub Actions secret, never commit)
# POSTHOG_PERSONAL_API_KEY=  # optional: query error tracking from posthog-sync.ts
# LINEAR_SELF_HEAL_PROJECT_ID=1259fce9-8751-45b4-a2c7-e39088feae3d


# Stripe (optional — required for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Server-side checkout (see apps/dashboard/scripts/setup-stripe-products.ts)
# The billing page sends planId; these IDs stay on the server.
STRIPE_PRO_PRICE_ID=price_...
STRIPE_STUDENT_PRICE_ID=price_...
STRIPE_ULTRA_PRICE_ID=price_...
STRIPE_FAMILY_PRICE_ID=price_...
STRIPE_FAMILY_MAX_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
STRIPE_AGENTS_ADDON_PRICE_ID=price_...
STRIPE_WEB_SEARCH_ADDON_PRICE_ID=price_...
STRIPE_TOPUP_20_PRICE_ID=price_...
STRIPE_TOPUP_30_PRICE_ID=price_...
STRIPE_TOPUP_50_PRICE_ID=price_...
STRIPE_TOPUP_100_PRICE_ID=price_...
STRIPE_TOPUP_200_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional — Starter tier if you add a paid starter price later
# STRIPE_STARTER_PRICE_ID=price_...

# No signup credit. First top-up of $20+ grants $5 open-weight bonus (see TOPUP_BONUS_* in plans.ts).
SIGNUP_CREDIT_USD_CENTS=0
# Leave at 0 — included usage is a monthly credit stipend, not a 4h window
PLAN_BUDGET_PRO_PER_4H_CENTS=0
PLAN_BUDGET_TEAM_PER_4H_CENTS=0
PLAN_BUDGET_ENTERPRISE_PER_4H_CENTS=0

# WorkOS AuthKit (required for hosted login / SSO)
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD= # openssl rand -base64 24  (≥32 chars)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3010/callback
# Production (Firebase Hosting site opendoor-gcp):
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://opendoor-gcp.web.app/callback

# Custom Domains (optional — Azure Front Door)
AZURE_GATEWAY_DOMAIN=api.opendoor.ai
AZURE_DASHBOARD_DOMAIN=app.opendoor.ai
AZURE_DOCS_DOMAIN=docs.opendoor.ai

# Azure Communication Services (optional — required for email notifications)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://...;accesskey=...
EMAIL_SENDER_ADDRESS=noreply@opendoor.ai

# OpenTelemetry / Azure Monitor (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
OTEL_SERVICE_NAME=opendoor-gateway
OTEL_SERVICE_VERSION=1.0.0

# DuckDB Analytics
DUCKDB_ANALYTICS_ENABLED=false

# Azure Blob Storage (optional — required for Parquet ETL archival)
AZURE_STORAGE_ACCOUNT_NAME=opendooranalytics...
AZURE_STORAGE_ACCOUNT_KEY=...
AZURE_STORAGE_CONTAINER_NAME=analytics

# Azure (optional)
AZURE_REGION=westeurope
AZURE_AI_FOUNDRY_ENDPOINT=https://...
AZURE_AI_FOUNDRY_KEY=...

# GCP (all-Google production — Firebase Hosting + Cloud Run + Cloud SQL + Memorystore)
GCP_PROJECT_ID=project-800192c2-3ecc-4889-8f7
GCP_REGION=us-central1
FIREBASE_SITE_ID=opendoor-gcp
# After deploy: https://opendoor-gcp.web.app
# GCP backend project (Cloud SQL / Artifact Registry): project-800192c2-3ecc-4889-8f7
# CLOUDSQL_CONNECTION_NAME=project-800192c2-3ecc-4889-8f7:us-central1:opendoor-pg
# Production DATABASE_URL / REDIS_URL live in Secret Manager (opendoor-database-url, opendoor-redis-url)
GCP_GPU_TYPE=nvidia-l4
GCP_VLLM_IMAGE=vllm/vllm-openai:latest
# /v1/files — GCS when set (ADC); otherwise local tmp/opendoor-files
# OPENDOOR_FILES_BUCKET=opendoor-files
# OPENDOOR_FILES_PREFIX=opendoor-files
# OPENDOOR_FILES_DIR=tmp/opendoor-files

# Local GPU (Ollama on this machine)
OLLAMA_HOST=http://127.0.0.1:11434
# Optional OpenAI-compatible image server for Studio (POST {base}/v1/images/generations).
# Unset = Studio uses OpenAI / Azure / Vertex when those keys exist; otherwise Studio is offline.
# Do not point this at ComfyUI. Local default is not :8188.
# PRIVATE_IMAGE_GEN_URL=http://127.0.0.1:8000
# PRIVATE_IMAGE_GEN_KIND=openai
# PRIVATE_IMAGE_GEN_ALLOW_FALLBACK=1
GATEWAY_PORT=3001

# Cachet Status Page (optional — requires deployed Cachet Container App)
CACHET_URL=https://status.yourdomain.com
CACHET_API_KEY=your-cachet-api-key
CACHET_ENABLED=true

# Internal API key for gateway internal endpoints (e.g. /internal/cachet-sync)
# Dashboard AI Assistants bills the owner org with this same secret + X-OpenDoor-Organization-Id.
INTERNAL_API_KEY=your-internal-api-key
GATEWAY_INTERNAL_KEY=your-internal-api-key

# Workflow code_execution — production jail is Cloud Run gVisor (opendoor-sandbox).
# Unset CODE_SANDBOX_URL to use the local execFile fallback (macOS / laptop).
# CODE_SANDBOX_URL=https://opendoor-sandbox-xxxxx.us-central1.run.app
# CODE_SANDBOX_TOKEN=
# FIRECRACKER_SOCKET=   # Linux jailer Unix socket only; ignored on macOS (no fake KVM)

# LLM Provider API Keys (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
COHERE_API_KEY=...
MISTRAL_API_KEY=...
DEEPSEEK_API_KEY=...
# DashScope / Alibaba Cloud Model Studio (Qwen 3.8 Max). International default:
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Beijing accounts: QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CEREBRAS_API_KEY=...
PERPLEXITY_API_KEY=...

# Serverless wholesale — Vertex AI Model Garden is primary (same ADC / project as web search).
# No TOGETHER_API_KEY required. Together is optional overflow for legacy ids
# (llama-3.1-8b-instruct, qwen2.5-*, deepseek-v3, mistral-7b-instruct, BGE).
# GOOGLE_CLOUD_PROJECT=project-800192c2-3ecc-4889-8f7
# GCP_PROJECT=project-800192c2-3ecc-4889-8f7
# GCP_PROJECT_ID=project-800192c2-3ecc-4889-8f7
# VERTEX_LOCATION=global
# VERTEX_IMAGE_LOCATION=global
# VERTEX_IMAGEN_LOCATION=us-central1
# VERTEX_VEO_LOCATION=us-central1
# VERTEX_IMAGE_MODEL=gemini-3.1-flash-image
# VERTEX_VEO_MODEL=veo-3.1-fast-generate-001
# VERTEX_API_KEY=
# Auth: gcloud auth application-default login
#       gcloud auth application-default set-quota-project project-800192c2-3ecc-4889-8f7
# Optional overflow:
# TOGETHER_API_KEY=...
# TOGETHER_BASE_URL=https://api.together.xyz/v1

# Capacity controls
# GATEWAY_SHED_STANDARD=1
# GATEWAY_MAX_STANDARD_INFLIGHT=80
# PROMPT_CACHE_AFFINITY_TTL_SEC=3600
# Optional alternatives later: FIREWORKS_API_KEY
GROQ_API_KEY=
XAI_API_KEY=
# Training — Vertex AI is primary (tuningJobs for Gemini/Gemma SFT; CustomJob otherwise).
# Together is optional overflow. Simulated ft: ids are local/dev only.
# VERTEX_TUNING_LOCATION=us-central1
# VERTEX_TUNING_BUCKET=
# VERTEX_CUSTOM_TRAINING_IMAGE=
# VERTEX_CUSTOM_MACHINE_TYPE=n1-standard-4
# VERTEX_CUSTOM_ACCELERATOR_TYPE=
# VERTEX_CUSTOM_ACCELERATOR_COUNT=
# TOGETHER_API_KEY=
# Local/dev only — never honored when NODE_ENV=production or Cloud Run
# ALLOW_SIMULATED_TRAINING=1


# Smart Router — dynamic provider selection by health, latency, and cost
SMART_ROUTER_ENABLED=true
ROUTER_HEALTH_WEIGHT=60
ROUTER_LATENCY_WEIGHT=30
ROUTER_COST_WEIGHT=10
ROUTER_MIN_HEALTH=0.2
ROUTER_HEALTH_WINDOW_MS=300000
ROUTER_LATENCY_MAX_AGE_MS=1800000
ROUTER_MAX_LATENCY_MS=10000
ROUTER_MAX_COST_USD=0.5

# OpenDoor Search (first-party, metered) — customers pay catalog list price per query
# (SEARCH_QUERY_LIST_CENTS in packages/shared/src/platform-tools.ts) or the Web Search add-on.
# Visible on Tools / Pricing; enable to use. Site admins are unlimited. Not a free-credit giveaway.
# Engine: Vertex Gemini + Google Search grounding on OUR GCP. Not a You.com / Serper / Brave reseller.
# OpenDoor Search does not read YOU_COM_API_KEY, SERPER_API_KEY, or BRAVE_SEARCH_API_KEY.
# Enable once on the project:
#   gcloud services enable aiplatform.googleapis.com discoveryengine.googleapis.com --project project-800192c2-3ecc-4889-8f7
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project project-800192c2-3ecc-4889-8f7
# Docs: https://docs.cloud.google.com/vertex-ai/generative-ai/docs/grounding/grounding-with-google-search
# GOOGLE_CLOUD_PROJECT=project-800192c2-3ecc-4889-8f7
# GCP_PROJECT=project-800192c2-3ecc-4889-8f7
# VERTEX_LOCATION=global
# VERTEX_SEARCH_MODEL=gemini-2.5-flash
# VERTEX_RAG_MODEL=gemini-2.5-flash
# Optional Vertex AI Search (Discovery Engine) if you already created an engine:
# VERTEX_SEARCH_ENGINE_ID=
# VERTEX_DATA_STORE_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# VERTEX_API_KEY=
# VERTEX_ACCESS_TOKEN=
# Customers subscribe via STRIPE_WEB_SEARCH_ADDON_PRICE_ID or enable the Search tool and spend credits.

# API Connection encryption key (AES-256-GCM)
API_SECRET_KEY=change-me-in-production-32-char-key-ok

# MIT OpenBot computers. Not CopilotKit Intelligence.
# Per-Bot isolation (recommended): one Chromium + /workspace per agent.
# The dashboard Start computer button calls this supervisor.
# docker compose up -d openbot-supervisor
OPENBOT_SUPERVISOR_URL=http://127.0.0.1:4300
OPENBOT_SUPERVISOR_TOKEN=opendoor-openbot-supervisor-dev
OPENBOT_COMPUTER_TOKEN=opendoor-openbot-dev
# Optional gVisor, when the host has runsc: OPENBOT_COMPUTER_RUNTIME=runsc
# Shared single computer instead (no isolation):
# docker compose --profile shared-computer up -d openbot-computer
# OPENBOT_COMPUTER_URL=http://127.0.0.1:4100
# AGENT_COMPUTER_ALLOW_PRIVATE_HOSTS=true
# Optional AG-UI Bot (apps/openbot-bot) pointed at this gateway:
# OPENBOT_MODEL=llama-3.1-8b-instruct
# Optional: embed agent notes + /workspace files via POST /v1/embeddings (same agent API key).
# Unset = lexical + kind + recency recall only.
# AGENT_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
