# OpenDoor Environment Variables

# Database
DATABASE_URL=postgresql://localhost:5432/opendoor

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=your-super-secret-jwt-key-change-in-production

# Gateway
GATEWAY_API_KEY_HASH_SECRET=another-secret-for-hashing-api-keys
PORT=3001

# Dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public status page calls this URL for /status (same host the browser uses in prod, e.g. https://api.yourdomain.com)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
PORT=3000

# PostHog (ProjectOpenDoor — https://us.posthog.com/project/407244)
# Project API key from PostHog Project Settings (safe in the browser; still treat as a secret in CI logs).
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# Ingestion API host: US default below; use https://eu.i.posthog.com for EU.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Toolbar / session replay “open in PostHog” UI (match your PostHog region).
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Same key for Next.js server and the Bun gateway (server-only env is fine too).
POSTHOG_API_KEY=phc_your_project_api_key
POSTHOG_HOST=https://us.i.posthog.com

# Stripe (optional — required for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Server-side checkout (see apps/dashboard/scripts/setup-stripe-products.ts)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
STRIPE_TOPUP_30_PRICE_ID=price_...
STRIPE_TOPUP_50_PRICE_ID=price_...
STRIPE_TOPUP_100_PRICE_ID=price_...
STRIPE_TOPUP_200_PRICE_ID=price_...
# Same price IDs — required for the billing page (Next inlines these at build in Docker)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TOPUP_30_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TOPUP_50_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TOPUP_100_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TOPUP_200_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional — Starter tier if you add a paid starter price later
# STRIPE_STARTER_PRICE_ID=price_...

# Credits and rolling 4h allowance budgets
SIGNUP_CREDIT_USD_CENTS=2000
PLAN_BUDGET_PRO_PER_4H_CENTS=500
PLAN_BUDGET_ENTERPRISE_PER_4H_CENTS=3000

# WorkOS SSO (optional — required for enterprise SSO)
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...

# Custom Domains (optional — Azure Front Door)
AZURE_GATEWAY_DOMAIN=api.opendoor.ai
AZURE_DASHBOARD_DOMAIN=app.opendoor.ai
AZURE_DOCS_DOMAIN=docs.opendoor.ai

# Azure Communication Services (optional — required for email notifications)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://...;accesskey=...
EMAIL_SENDER_ADDRESS=noreply@opendoor.ai

# OpenTelemetry / Azure Monitor (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
OTEL_SERVICE_NAME=opendoor-gateway
OTEL_SERVICE_VERSION=1.0.0

# DuckDB Analytics
DUCKDB_ANALYTICS_ENABLED=false

# Azure Blob Storage (optional — required for Parquet ETL archival)
AZURE_STORAGE_ACCOUNT_NAME=opendooranalytics...
AZURE_STORAGE_ACCOUNT_KEY=...
AZURE_STORAGE_CONTAINER_NAME=analytics

# Azure (production only)
AZURE_REGION=westeurope
AZURE_AI_FOUNDRY_ENDPOINT=https://...
AZURE_AI_FOUNDRY_KEY=...

# Cachet Status Page (optional — requires deployed Cachet Container App)
CACHET_URL=https://status.yourdomain.com
CACHET_API_KEY=your-cachet-api-key
CACHET_ENABLED=true

# Internal API key for gateway internal endpoints (e.g. /internal/cachet-sync)
INTERNAL_API_KEY=your-internal-api-key

# LLM Provider API Keys (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
COHERE_API_KEY=...
MISTRAL_API_KEY=...
DEEPSEEK_API_KEY=...
QWEN_API_KEY=...

# Smart Router — dynamic provider selection by health, latency, and cost
SMART_ROUTER_ENABLED=true
ROUTER_HEALTH_WEIGHT=60
ROUTER_LATENCY_WEIGHT=30
ROUTER_COST_WEIGHT=10
ROUTER_MIN_HEALTH=0.2
ROUTER_HEALTH_WINDOW_MS=300000
ROUTER_LATENCY_MAX_AGE_MS=1800000
ROUTER_MAX_LATENCY_MS=10000
ROUTER_MAX_COST_USD=0.5

# API Connection encryption key (AES-256-GCM)
API_SECRET_KEY=change-me-in-production-32-char-key-ok
