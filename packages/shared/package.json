{
  "name": "@opendoor/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./rag-search": {
      "types": "./src/rag-search.ts",
      "import": "./src/rag-search.ts",
      "require": "./dist/rag-search.js",
      "default": "./src/rag-search.ts"
    },
    "./agent-execute": {
      "types": "./src/agent-execute.ts",
      "import": "./src/agent-execute.ts",
      "require": "./dist/agent-execute.js",
      "default": "./src/agent-execute.ts"
    },
    "./agent-tools": {
      "types": "./src/agent-tools.ts",
      "import": "./src/agent-tools.ts",
      "require": "./dist/agent-tools.js",
      "default": "./src/agent-tools.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opendoor/config": "workspace:*",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0"
  }
}
