{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opendoor-edge-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ORIGIN_URL": "https://alphonce-edge-proxy.cloudflare-edge.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
