# ==============================================================================
# Supabase Self-Hosted Production Configuration Template
# Generate values automatically using: bun run infra/gcp/supabase/generate-keys.ts --env
# ==============================================================================

# 1. Edge Ingress & Domain (Caddy Auto-TLS)
# Set your domain for automatic Let's Encrypt HTTPS (e.g. api.opendoor.ai).
# If left as :80, Caddy will serve HTTP on port 80.
SITE_ADDRESS=:80
LETSENCRYPT_EMAIL=admin@opendoor.ai
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:3010
URI_ALLOW_LIST=*

# 2. Cryptographic Secrets (Generated via generate-keys.ts)
JWT_SECRET=your-256-bit-jwt-secret-hex
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
POSTGRES_PASSWORD=your-secure-postgres-password
SECRET_KEY_BASE=your-32-byte-secret-key-base-hex
VAULT_ENC_KEY=your-16-byte-vault-key-hex

# 3. Studio Dashboard Admin Credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-studio-password
STUDIO_ORG_NAME=OpenDoor
STUDIO_PROJECT_NAME=Production

# 4. Storage & Persistence
# On GCP GCE, point DATA_DIR to the mounted SSD persistent disk
DATA_DIR=/var/lib/supabase-data

# 5. GCP Infrastructure & Backups
GCP_PROJECT_ID=project-800192c2-3ecc-4889-8f7
GCP_REGION=us-central1
GCS_BACKUP_BUCKET=opendoor-supabase-backups-800192c2
