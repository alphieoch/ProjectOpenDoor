{
  "name": "opendoor",
  "private": true,
  "version": "1.0.0",
  "description": "OpenDoor — Open-weight LLM API for Africa and the Global South, powered by Bun",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @opendoor/database db:generate",
    "db:migrate": "pnpm --filter @opendoor/database db:migrate",
    "db:studio": "pnpm --filter @opendoor/database db:studio",
    "gateway:dev": "pnpm --filter @opendoor/gateway dev",
    "gateway:start": "pnpm --filter @opendoor/gateway start",
    "dashboard:dev": "pnpm --filter @opendoor/dashboard dev",
    "dashboard:start": "pnpm --filter @opendoor/dashboard start",
    "docs:dev": "npx @docs.page/cli preview",
    "docs:check": "npx @docs.page/cli check --external-links warn --metadata warn",
    "stripe:setup": "bun --env-file=.env apps/dashboard/scripts/setup-stripe-products.ts",
    "etl:run": "DUCKDB_ANALYTICS_ENABLED=true bun --env-file=.env apps/gateway/src/scripts/etl-to-parquet.ts",
    "od": "bun --env-file=.env apps/cli/src/index.ts",
    "ingest:open-models": "bun --env-file=.env run scripts/ingest-open-models.ts",
    "seed:serverless": "bun --env-file=.env run scripts/seed-serverless.ts",
    "gcp:bootstrap": "bash scripts/bootstrap-gcp.sh",
    "gcp:deploy": "bash scripts/deploy-gcp.sh",
    "gcp:sql-proxy": "bash scripts/cloud-sql-proxy.sh",
    "gcp:secret": "bash scripts/upsert-gcp-secret.sh",
    "gcp:finish-ops": "bash scripts/finish-ops.sh",
    "gcp:edge-lb": "bash scripts/setup-edge-lb.sh",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "server-only": "file:./scripts/server-only-stub"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
