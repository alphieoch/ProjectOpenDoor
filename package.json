{
  "name": "opendoor",
  "private": true,
  "version": "1.0.0",
  "description": "OpenDoor — Multi-region LLM API Gateway on Azure, powered by Bun",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @opendoor/database db:generate",
    "db:migrate": "pnpm --filter @opendoor/database db:migrate",
    "db:studio": "pnpm --filter @opendoor/database db:studio",
    "gateway:dev": "pnpm --filter @opendoor/gateway dev",
    "gateway:start": "pnpm --filter @opendoor/gateway start",
    "dashboard:dev": "pnpm --filter @opendoor/dashboard dev",
    "dashboard:start": "pnpm --filter @opendoor/dashboard start",
    "docs:dev": "pnpm --filter @opendoor/docs start --port 3002",
    "docs:build": "pnpm --filter @opendoor/docs build",
    "docs:serve": "pnpm --filter @opendoor/docs serve",
    "stripe:setup": "bun --env-file=.env apps/dashboard/scripts/setup-stripe-products.ts",
    "etl:run": "DUCKDB_ANALYTICS_ENABLED=true bun --env-file=.env apps/gateway/src/scripts/etl-to-parquet.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "bun": ">=1.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
